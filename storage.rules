rules_version = '2';

// Firebase 콘솔 → Storage → Rules 에 이 내용을 붙여 넣고 '게시'를 누르세요.
// (처음 켤 때 고른 '테스트 모드'는 30일 뒤 만료되므로 반드시 이걸로 바꿔야 합니다)
//
// ⚠️ regions/ 는 **웹(map/)이 쓰는 자리**라 로그인이 없습니다.
//    정적 페이지에는 서버 쪽 로그인이 없어서 '주소를 아는 사람은 누구나' 읽고 씁니다.
//    (사이트 4자리 잠금은 브라우저 안에서만 도는 대문 잠금이라 규칙으로는 확인 불가)
//    대신 경로·용량·형식을 좁게 제한해 뒀습니다.
//
//    반면 **spaces/ 는 멤버만** 봅니다 — 앱에 로그인이 붙어서 판단할 수 있게 됐습니다.

service firebase.storage {
  match /b/{bucket}/o {

    // 사진 목록 조회(list)는 파일이 아니라 '폴더 경로'에 대한 읽기 권한을 봅니다.
    // 이게 없으면 사진이 올라가도 다른 기기에서 목록을 못 받아옵니다.
    // ⚠️ 클라이언트가 delimiter 를 같이 보내야 이 규칙이 적용됩니다.
    //    안 보내면 '버킷 전체 목록'으로 취급돼 아래 catch-all 에서 막힙니다(403).
    match /regions {
      allow read: if true;
    }

    // 지역 사진 한 장: regions/<지역코드>.jpg
    match /regions/{file} {
      allow read: if true;
      allow write: if request.resource == null                       // 삭제
                   || (request.resource.size < 5 * 1024 * 1024       // 5MB 이하
                       && request.resource.contentType == 'image/jpeg');
    }

    // ── 앱(안드로이드·iOS)이 쓰는 짜국 단위 경로 ──
    //
    // **여기서부터는 멤버만 봅니다.** 짜국 ID 를 알아도 멤버가 아니면 못 읽습니다.
    //
    // Storage 규칙은 다른 파일의 내용을 못 읽어서, 멤버 목록을 Storage 에 두면
    // "경로를 아는 사람은 통과" 가 됩니다. 그래서 멤버 문서를 Firestore 에 두고
    // 여기서 건너다봅니다 (`firestore.rules`, `docs/app/AUTH.md`).
    function isMember(spaceId) {
      return request.auth != null &&
             firestore.exists(
               /databases/(default)/documents/spaces/$(spaceId)/members/$(request.auth.uid)
             );
    }

    // 대표사진 목록 — 작은 JSON 하나
    match /spaces/{spaceId}/{doc} {
      allow read: if isMember(spaceId);
      allow write: if isMember(spaceId)
                   && doc == 'covers.json'
                   && request.resource != null
                   && request.resource.size < 256 * 1024;
    }

    // 사진 목록 조회(list). regions 와 같은 이유로 폴더 경로에 읽기 권한이 필요하고,
    // 클라이언트가 delimiter 를 같이 보내야 이 규칙이 적용됩니다.
    match /spaces/{spaceId}/photos {
      allow read: if isMember(spaceId);
    }

    // 사진 한 장: spaces/<짜국ID>/photos/<날짜>_<지역코드>_<사진ID>.jpg
    match /spaces/{spaceId}/photos/{file} {
      allow read: if isMember(spaceId);
      allow write: if isMember(spaceId)
                   && (request.resource == null                      // 삭제
                       || (request.resource.size < 5 * 1024 * 1024   // 5MB 이하
                           && request.resource.contentType == 'image/jpeg'));
    }

    // 그 외 경로는 전부 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
