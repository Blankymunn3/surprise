    <string name="space_back">뒤로</string>
    <string name="space_more">더 보기</string>
    <string name="space_add_photo">사진 올리기</string>

    <!-- 지도 | 달력. **순서가 뜻을 가지므로** 배열입니다 (0 이 지도). -->
    <string-array name="space_tabs">
        <item>지도</item>
        <item>달력</item>
    </string-array>

