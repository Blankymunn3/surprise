<?xml version="1.0" encoding="utf-8"?>
<!--
  앱 껍데기의 글 — 화면과 화면을 잇는 자리(스낵바·공유·머리말)에서 씁니다.
  화면 안쪽의 말은 그 화면 모듈의 strings.xml 에 있습니다.
