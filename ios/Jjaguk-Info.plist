<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App/ 폴더 밖에 둔 이유: App/ 은 Xcode 가 "폴더 안의 파일을 전부 알아서 넣는" 방식
  (동기화 그룹)이라, Info.plist 가 그 안에 있으면 앱 자원으로도 한 번 더 복사됩니다.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<!-- 홈 화면에 보이는 이름. 값은 빌드 구성이 넣습니다(APP_DISPLAY_NAME) —
	     dev 는 '짜국 Dev' 로 갈라 폰에 나란히 설치했을 때 어느 쪽인지 보이게 합니다.
	     코드 안쪽 이름은 로마자(Jjaguk)입니다 — 실행 파일에 한글을 쓰지 않습니다. -->
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Jjaguk</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!--
	  Pretendard 네 벌. 파일은 안드로이드와 **같은 것**을 그대로 가리킵니다
	  (`android/core/designsystem/src/main/res/font/`) — 복사본을 두면 두 앱의
	  글씨가 조용히 달라질 수 있습니다.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>pretendard_regular.ttf</string>
		<string>pretendard_medium.ttf</string>
		<string>pretendard_semibold.ttf</string>
		<string>pretendard_bold.ttf</string>
		<string>galmuri11.ttf</string>
		<string>galmuri11_bold.ttf</string>
		<string>galmuri9.ttf</string>
		<string>press_start_2p.ttf</string>
	</array>
	<!--
	  구글 로그인 창이 **앱으로 돌아오는 문**입니다. 이 값은
	  `ios/App/GoogleService-Info.plist` 의 `REVERSED_CLIENT_ID` 와 같아야 합니다 —
	  다르면 로그인 창이 열리고도 돌아오지 못해 그대로 멈춥니다.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.419812459548-nsun9ha7faersg7hlp0gmp27gpj6em8j</string>
				<!-- dev 빌드(kr.jjaguk.app.dev)의 리다이렉트. plist 는 구성 공용이라 둘 다 둔다. -->
				<string>com.googleusercontent.apps.419812459548-5o4p7j8m1i6farj1m7klm61sfh8viaud</string>
			</array>
		</dict>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>추억으로 남길 사진을 고르려면 사진 접근이 필요해요.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>지금 있는 곳을 지도에서 찾으려면 위치 접근이 필요해요.</string>
</dict>
</plist>
